# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Protects the publish endpoint that the cron/worker calls. Any long random string.
CRON_SECRET=change-me-to-a-long-random-string

# Development: lets you add simulated social accounts that publish nowhere.
ENABLE_MOCK_ACCOUNTS=true

# Base URL of this app (used by the worker to call the publish endpoint).
APP_URL=http://localhost:3000

# Meta (Facebook Pages + Instagram). From developers.facebook.com -> your app -> App settings -> Basic.
# Add {APP_URL}/api/oauth/meta/callback as a Valid OAuth Redirect URI.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# LinkedIn (company pages). From linkedin.com/developers -> your app -> Auth.
# Add {APP_URL}/api/oauth/linkedin/callback as an authorized redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
# Optional: requested permissions (space separated). Default below. For Inbox comments add
# r_organization_social_feed w_organization_social_feed once LinkedIn has granted them to your app.
# LINKEDIN_SCOPES=w_organization_social r_organization_social rw_organization_admin

# X. From developer.x.com -> your app -> User authentication settings (OAuth 2.0, Web App).
# Callback: {APP_URL}/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# YouTube (Google Cloud project with YouTube Data API v3 enabled; OAuth client type "Web application").
# Redirect URI: {APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok (developers.tiktok.com app with Login Kit + Content Posting API, Direct Post enabled).
# Redirect URI: {APP_URL}/api/oauth/tiktok/callback. Verify your APP_URL domain for photo posts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Threads (Meta app with the Threads use case). Redirect URI: {APP_URL}/api/oauth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

# Email alerts (failed posts, expiring connections) via resend.com. Optional; without it alerts are logged.
RESEND_API_KEY=
ALERT_EMAIL_FROM=SocialOS <alerts@yourdomain.com>

# Signs /m/... media links (defaults to CRON_SECRET).
MEDIA_PROXY_SECRET=

# AI (Content agent "Write with AI" and "AI check"). From platform.claude.com -> API keys.
ANTHROPIC_API_KEY=
# Optional overrides. Default model: claude-opus-5.
AI_MODEL=
# The monthly AI spend cap per organization comes from its plan (Settings -> Billing).

# Images (Creative studio). Each tier appears only when its key is set.
# Free AI images: Cloudflare Workers AI (FLUX.1 schnell). dash.cloudflare.com -> AI -> Workers AI -> Use REST API.
# Token needs "Workers AI - Read" and "Workers AI - Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Standard: Google Gemini image (aistudio.google.com -> API keys). No free tier for image models.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Premium: OpenAI GPT Image (platform.openai.com -> API keys).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
# Your current OpenAI price per image at that model/quality, for the usage log and budget.
OPENAI_IMAGE_USD=0.05
# Free stock photos: pexels.com/api (free key).
PEXELS_API_KEY=

# Billing (Stripe). dashboard.stripe.com -> Developers -> API keys. Use sk_test_ keys until launch.
# Without a key the billing page shows plans but checkout is disabled.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://YOUR_APP/api/webhooks/stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Tracked links (optional). Short links default to {APP_URL}/l/{code}; set a shorter domain pointing at
# this app to use it instead, e.g. https://sos.link. LINK_HASH_SECRET salts anonymous visitor ids
# (defaults to MEDIA_PROXY_SECRET).
SHORT_LINK_BASE_URL=
LINK_HASH_SECRET=

# How SocialOS runs. Unset or "company" (default): your company's own tool. Billing off, invite-only
# sign-up (platform admins create the company, everyone else joins by invitation), no public landing
# page. "saas": the subscription product with public sign-up, free trial, plans and Stripe billing.
APP_MODE=
# Company mode: monthly AI spending cap per workspace in USD (default 200).
AI_MONTHLY_BUDGET_USD=

# SocialOS staff who can open the platform admin console (/admin): comma-separated, confirmed emails.
PLATFORM_ADMIN_EMAILS=

# Legal pages (/legal/privacy, /legal/terms, /legal/data-deletion). Required by every platform's app
# review. The texts are templates: have them reviewed by a lawyer.
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE_DATE=
